# Required shared secret. AGXORA sends: Authorization: Bearer <this value>
# Must match AGXORA_EMAIL_HTTP_TOKEN. Never commit the real value.
EMAIL_WORKER_TOKEN=

# ESP selector. Default: resend
EMAIL_WORKER_ESP=resend

# Resend (preferred). Exists ONLY in this worker's environment.
# Never put this key in the AGXORA app environment or repository.
RESEND_API_KEY=

# Postmark (alternative). Use instead of RESEND_API_KEY when EMAIL_WORKER_ESP=postmark.
POSTMARK_SERVER_TOKEN=

# Optional: reject From addresses other than this exact mailbox.
# Production should be noreply@agxora.de after the ESP domain is verified.
EMAIL_WORKER_ALLOWED_FROM=noreply@agxora.de

# Listen address (Node HTTP server).
EMAIL_WORKER_HOST=127.0.0.1
EMAIL_WORKER_PORT=8787

# Max JSON body size in bytes (default 65536).
EMAIL_WORKER_MAX_BYTES=65536
