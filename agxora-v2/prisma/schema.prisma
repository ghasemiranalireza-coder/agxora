// AGXORA Phase 42.1 + Phase 43 + Phase 44 + Phase 45-B + Phase 47 + Phase 48 + Phase 49 + Phase 50 + Phase 56 + Phase 60 + Phase 62 + Phase 63.1 + Phase 70 + Phase 80 finance core
// PostgreSQL source of truth for User / Organization / Workspace / Membership /
// Session / Customer / Contact / Note / Invitation / OwnershipTransfer /
// ControlPlaneAuditEvent / AgentOsState / CreativeAsset (IMAGE inline + video object refs) /
// business-agent integrations, campaigns, runs, and external-action audit

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REVOKED
}

enum CustomerStatus {
  lead
  prospect
  active
  inactive
  vip
  archived
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique
  name           String
  /// Legacy LocalAuth id (usr_…) — not used as authentication authority
  externalAuthId String?  @unique
  emailVerified  Boolean  @default(false)
  /// bcrypt password hash (Phase 43). Never return to clients.
  passwordHash   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships            Membership[]
  sessions               Session[]
  ownedOrganizations      Organization[]          @relation("OrganizationOwner")
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  invitationsSent         Invitation[]            @relation("InvitationInviter")
  ownershipTransfersFrom  OwnershipTransfer[]     @relation("OwnershipTransferFrom")
  ownershipTransfersTo    OwnershipTransfer[]     @relation("OwnershipTransferTo")
  auditEvents             ControlPlaneAuditEvent[]
  socialOAuthStates       SocialOAuthState[]
  agentRuns               AgentRun[]
  externalActionAudits    ExternalActionAudit[]
  createdDeliveryNotes    DeliveryNote[] @relation("DeliveryNoteCreatedBy")
  createdInvoices         Invoice[]      @relation("InvoiceCreatedBy")
  uploadedFinanceLogos    FinanceDocumentLogo[] @relation("FinanceDocumentLogoUploadedBy")

  @@index([externalAuthId])
  @@map("users")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  ownerId   String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User         @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  workspaces  Workspace[]
  memberships Membership[]
  customers   Customer[]
  contacts    Contact[]
  notes       Note[]
  customerDocuments CustomerDocument[]
  customerActivities CustomerActivity[]
  deliveryNotes           DeliveryNote[]
  invoices                Invoice[]
  financeNumberSequences  FinanceNumberSequence[]
  financeIdempotencyKeys  FinanceIdempotencyKey[]
  financeDocumentSettings FinanceDocumentSettings[]
  financeDocumentLogos    FinanceDocumentLogo[]
  invitations         Invitation[]
  ownershipTransfers  OwnershipTransfer[]
  auditEvents         ControlPlaneAuditEvent[]
  agentOsState              AgentOsState?
  creativeAssets            CreativeAsset[]
  socialPlatformCredentials SocialPlatformCredential[]
  socialOAuthStates         SocialOAuthState[]
  creativePublishAttempts   CreativePublishAttempt[]
  creativeYouTubeUploadSessions CreativeYouTubeUploadSession[]
  integrationConnections    IntegrationConnection[]
  agentPolicies             AgentPolicy[]
  agentRuns                 AgentRun[]
  campaigns                 Campaign[]
  campaignItems             CampaignItem[]
  externalActionAudits      ExternalActionAudit[]
  agentGovernedExecutions   AgentGovernedExecution[]
  agentGovernedEvidence     AgentGovernedEvidence[]
  commercialSubscription    CommercialSubscription?
  commercialCheckouts       CommercialCheckout[]
  commercialBillingEvents   CommercialBillingEvent[]

  @@index([ownerId])
  @@map("organizations")
}

enum SocialPlatform {
  youtube
  gmail
}

enum CreativePublishAttemptStatus {
  in_flight
  uploading
  succeeded
  failed
  unavailable
}

/// Phase 63.1 — org-scoped encrypted OAuth credentials (never in Agent OS JSON).
model SocialPlatformCredential {
  id                   String         @id @default(uuid()) @db.Uuid
  organizationId       String         @db.Uuid
  platform             SocialPlatform
  externalAccountId    String?
  externalAccountName  String?
  scopes               String[]       @default([])
  /// AES-256-GCM encrypted JSON: { accessToken, refreshToken, tokenType }
  encryptedPayload     String         @db.Text
  accessTokenExpiresAt DateTime?
  revokedAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, platform])
  @@index([organizationId])
  @@map("social_platform_credentials")
}

/// Phase 63.1 — single-use PKCE OAuth state (hashed at rest).
model SocialOAuthState {
  id               String         @id @default(uuid()) @db.Uuid
  organizationId   String         @db.Uuid
  userId           String         @db.Uuid
  platform         SocialPlatform
  stateHash        String         @unique
  codeVerifierHash String
  /// AES-encrypted PKCE verifier — never returned to clients.
  encryptedCodeVerifier String      @db.Text
  redirectPath     String?
  consumedAt       DateTime?
  expiresAt        DateTime
  createdAt        DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, platform])
  @@index([expiresAt])
  @@map("social_oauth_states")
}

/// Phase 63.1 — publish idempotency + audit (no secrets).
model CreativePublishAttempt {
  id                    String                       @id @default(uuid()) @db.Uuid
  organizationId        String                       @db.Uuid
  publishExecutionJobId String
  creativeProjectId     String
  assetId               String
  platform              String
  idempotencyKey        String
  status                CreativePublishAttemptStatus
  publishResult         Json?
  externalId            String?
  errorReason           String?
  expiresAt             DateTime
  startedAt             DateTime                     @default(now())
  completedAt           DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  youtubeUploadSession CreativeYouTubeUploadSession?

  @@unique([organizationId, publishExecutionJobId])
  @@index([organizationId, idempotencyKey])
  @@index([status, expiresAt])
  @@map("creative_publish_attempts")
}

enum CreativeYouTubeUploadSessionStatus {
  pending
  uploading
  completed
  failed
  expired
}

/// Phase 65.0 — cross-request YouTube resumable upload sessions (encrypted URL, no OAuth tokens).
model CreativeYouTubeUploadSession {
  id                    String                           @id @default(uuid()) @db.Uuid
  organizationId        String                           @db.Uuid
  publishAttemptId      String                           @unique @db.Uuid
  publishExecutionJobId String
  creativeProjectId     String
  assetId               String
  objectKey             String
  actorUserId           String                           @db.Uuid
  mimeType              String
  byteSize              Int
  byteOffset            Int                              @default(0)
  encryptedResumableUrl String                           @db.Text
  status                CreativeYouTubeUploadSessionStatus
  workerClaimId         String?
  leaseExpiresAt        DateTime?
  expiresAt             DateTime
  errorReason           String?
  externalId            String?
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt
  completedAt           DateTime?

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publishAttempt CreativePublishAttempt @relation(fields: [publishAttemptId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, leaseExpiresAt])
  @@index([status, expiresAt])
  @@map("creative_youtube_upload_sessions")
}

enum CreativeAssetStorageBackend {
  inline_bytea
  object_s3
}

/// Phase 60 / 62 — durable creative assets (outside Agent OS JSON).
/// One primary asset per creative; IMAGE uses inline BYTEA; video uses object storage.
model CreativeAsset {
  id                 String                      @id
  organizationId     String                      @db.Uuid
  creativeProjectId  String
  mimeType           String
  byteSize           Int
  width              Int?
  height             Int?
  durationMs         Int?
  modality           String?
  providerId         String?
  providerAssetId    String?
  storageBackend     CreativeAssetStorageBackend @default(inline_bytea)
  objectBucket       String?
  objectKey          String?
  /// Inline IMAGE bytes when storageBackend=inline_bytea; null for object_s3.
  bytes              Bytes?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, creativeProjectId])
  @@index([organizationId])
  @@index([organizationId, creativeProjectId])
  @@map("creative_assets")
}

/// Phase 56 — org-scoped Agent OS snapshot (AgentsPersistedState v7 JSON).
/// One row per organization. Not a second Agent/Approval/Operations engine.
model AgentOsState {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @db.Uuid
  /// Mirrors AgentsPersistedState.version — remain 7
  schemaVersion  Int      @default(7)
  payload        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("agent_os_states")
}

model Workspace {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  slug           String
  /// Soft archive — archived workspaces cannot be switched into or mutated
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  customers    Customer[]
  contacts     Contact[]
  notes        Note[]
  customerDocuments CustomerDocument[]
  customerActivities CustomerActivity[]
  deliveryNotes           DeliveryNote[]
  invoices                Invoice[]
  financeNumberSequences  FinanceNumberSequence[]
  financeIdempotencyKeys  FinanceIdempotencyKey[]
  financeDocumentSettings FinanceDocumentSettings?
  financeDocumentLogos    FinanceDocumentLogo[]
  invitations         Invitation[]
  ownershipTransfers  OwnershipTransfer[]
  auditEvents         ControlPlaneAuditEvent[]
  integrationConnections IntegrationConnection[]
  agentPolicies          AgentPolicy[]
  agentRuns              AgentRun[]
  campaigns              Campaign[]
  campaignItems          CampaignItem[]
  externalActionAudits   ExternalActionAudit[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([archivedAt])
  @@map("workspaces")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  workspaceId    String           @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([organizationId])
  @@index([workspaceId])
  @@index([userId, organizationId, status])
  @@map("memberships")
}

/// Workspace invitation — raw token is never stored; only tokenHash.
model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  workspaceId    String    @db.Uuid
  invitedEmail   String
  role           MembershipRole
  tokenHash      String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  invitedById    String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([workspaceId, invitedEmail])
  @@index([organizationId])
  @@index([expiresAt])
  @@index([invitedById])
  @@map("invitations")
}

/// Controlled org ownership transfer — raw confirmation token never stored.
/// Pending transfer does not change Organization.ownerId or membership roles.
model OwnershipTransfer {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  workspaceId    String    @db.Uuid
  fromUserId     String    @db.Uuid
  toUserId       String    @db.Uuid
  tokenHash      String    @unique
  expiresAt      DateTime
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromUser     User         @relation("OwnershipTransferFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser       User         @relation("OwnershipTransferTo", fields: [toUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, expiresAt])
  @@index([workspaceId])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("ownership_transfers")
}

/// Compact control-plane audit — no secrets, no raw tokens.
model ControlPlaneAuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  workspaceId    String?  @db.Uuid
  actorUserId    String   @db.Uuid
  action         String
  targetUserId   String?  @db.Uuid
  invitationId   String?  @db.Uuid
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor        User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("control_plane_audit_events")
}

/// Server-authoritative session. Raw token lives only in httpOnly cookie; DB stores SHA-256 hash.
model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  /// Active workspace for multi-membership users — must be a membership of this user
  activeWorkspaceId String?   @db.Uuid
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

/// One-time password reset tokens — only tokenHash is stored.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Email verification tokens — delivery is a Phase follow-up when mail is configured.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  workspaceId    String         @db.Uuid
  companyName    String
  contactName    String
  email          String
  phone          String         @default("")
  website        String         @default("")
  industry       String         @default("")
  country        String         @default("")
  city           String         @default("")
  address        String         @default("")
  taxNumber      String         @default("")
  status         CustomerStatus @default(lead)
  owner          String         @default("")
  /// CrmTag[] JSON — label + color
  tags           Json           @default("[]")
  /// Marks seed/sample rows for honesty (Phase 40)
  isSample       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  notes        Note[]
  customerDocuments CustomerDocument[]
  customerActivities CustomerActivity[]
  deliveryNotes DeliveryNote[]
  invoices      Invoice[]

  @@index([workspaceId])
  @@index([organizationId])
  @@index([workspaceId, email])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@map("customers")
}

/// Phase 47 — CRM contact person (profile), not the deferred Note entity.
model Contact {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  workspaceId    String   @db.Uuid
  customerId     String   @db.Uuid
  name           String
  role           String   @default("")
  email          String   @default("")
  phone          String   @default("")
  mobile         String   @default("")
  /// Free-text notes on the contact person (not CrmNoteRecord persistence).
  notes          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([workspaceId])
  @@index([organizationId])
  @@index([customerId, createdAt])
  @@index([workspaceId, customerId])
  @@map("contacts")
}

/// Phase 48 — CRM Note entity (not Contact.notes free-text, not Activities).
model Note {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  workspaceId    String   @db.Uuid
  customerId     String   @db.Uuid
  title          String
  body           String
  /// Display author string (matches CrmNoteRecord / LocalStorage pattern).
  author         String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([workspaceId])
  @@index([organizationId])
  @@index([customerId, createdAt])
  @@index([workspaceId, customerId])
  @@map("notes")
}

/// Phase 49 — CRM document metadata (no blob/binary storage).
model CustomerDocument {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  workspaceId    String   @db.Uuid
  customerId     String   @db.Uuid
  name           String
  mimeType       String   @default("application/octet-stream")
  size           Int      @default(0)
  /// Display uploader string (matches CrmDocumentRecord / LocalStorage pattern).
  uploadedBy     String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([workspaceId])
  @@index([organizationId])
  @@index([customerId, createdAt])
  @@index([workspaceId, customerId])
  @@map("customer_documents")
}

/// Phase 50 — CRM customer profile activity (immutable timeline — not IAM audit).
model CustomerActivity {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  workspaceId    String   @db.Uuid
  customerId     String   @db.Uuid
  kind           String
  title          String
  detail         String   @default("")
  /// Display actor string (matches CrmActivityRecord / LocalStorage pattern).
  actor          String   @default("")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([workspaceId])
  @@index([organizationId])
  @@index([customerId, createdAt])
  @@index([workspaceId, customerId])
  @@map("customer_activities")
}

/// Phase 70 — official provider catalog ids (OAuth is implemented per-provider; YouTube already exists).
enum IntegrationProvider {
  email_gmail
  email_microsoft
  instagram
  facebook
  tiktok
  youtube
  linkedin
  x
}

enum IntegrationConnectionStatus {
  not_connected
  connected
  disconnected
  error
}

enum AutonomyMode {
  SAFE
  ASSISTED
  AUTONOMOUS
}

enum CampaignStatus {
  draft
  needs_approval
  approved
  scheduled
  executing
  completed
  failed
  cancelled
}

enum ContentItemStatus {
  DRAFT
  NEEDS_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum AgentRunStatus {
  PENDING
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum ExternalActionStatus {
  planned
  approval_required
  executing
  completed
  failed
  cancelled
}

/// Org+workspace connection metadata and SAFE-default permissions. Never stores OAuth tokens.
model IntegrationConnection {
  id                  String                       @id @default(uuid()) @db.Uuid
  organizationId      String                       @db.Uuid
  workspaceId         String                       @db.Uuid
  provider            IntegrationProvider
  status              IntegrationConnectionStatus  @default(not_connected)
  accountLabel        String?
  externalAccountId   String?
  lastError           String?
  canRead             Boolean                      @default(true)
  canCreateDraft      Boolean                      @default(true)
  canSchedule         Boolean                      @default(false)
  canPublish          Boolean                      @default(false)
  canSendEmail        Boolean                      @default(false)
  canDelete           Boolean                      @default(false)
  createdByUserId     String                       @db.Uuid
  connectedAt         DateTime?
  disconnectedAt      DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, workspaceId, provider])
  @@index([organizationId, workspaceId])
  @@index([workspaceId, provider])
  @@map("integration_connections")
}

/// Per-workspace autonomy. Default SAFE — never auto-escalate.
model AgentPolicy {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  workspaceId     String       @db.Uuid
  mode            AutonomyMode @default(SAFE)
  updatedByUserId String       @db.Uuid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, workspaceId])
  @@index([workspaceId])
  @@map("agent_policies")
}

model AgentRun {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  workspaceId    String         @db.Uuid
  userId         String         @db.Uuid
  campaignId     String?        @db.Uuid
  goal           String
  status         AgentRunStatus @default(PENDING)
  result         Json?
  error          String?
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  campaign     Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  steps        AgentRunStep[]

  @@index([organizationId, workspaceId, createdAt])
  @@index([workspaceId, status])
  @@index([userId])
  @@map("agent_runs")
}

model AgentRunStep {
  id             String         @id @default(uuid()) @db.Uuid
  agentRunId     String         @db.Uuid
  organizationId String         @db.Uuid
  workspaceId    String         @db.Uuid
  ordinal        Int
  name           String
  status         AgentRunStatus @default(PENDING)
  input          Json?
  output         Json?
  error          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@unique([agentRunId, ordinal])
  @@index([organizationId, workspaceId])
  @@map("agent_run_steps")
}

model Campaign {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  workspaceId     String         @db.Uuid
  createdByUserId String         @db.Uuid
  name            String
  objective       String         @default("")
  targetAudience  String         @default("")
  channels        IntegrationProvider[]
  startDate       DateTime?
  endDate         DateTime?
  status          CampaignStatus @default(draft)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items        CampaignItem[]
  agentRuns    AgentRun[]

  @@index([organizationId, workspaceId, createdAt])
  @@index([workspaceId, status])
  @@map("campaigns")
}

/// Content calendar row (campaign-scoped). External ids/URLs only after a real provider success.
model CampaignItem {
  id                String            @id @default(uuid()) @db.Uuid
  campaignId        String            @db.Uuid
  organizationId    String            @db.Uuid
  workspaceId       String            @db.Uuid
  createdByUserId   String            @db.Uuid
  approvedByUserId  String?           @db.Uuid
  provider          IntegrationProvider
  contentType       String
  title             String            @default("")
  caption           String            @default("")
  body              String            @default("")
  script            String            @default("")
  mediaRequirement  String            @default("")
  scheduledAt       DateTime?
  publishedAt       DateTime?
  status            ContentItemStatus @default(DRAFT)
  externalId        String?
  externalUrl       String?
  error             String?
  retryCount        Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([organizationId, workspaceId, scheduledAt])
  @@index([campaignId, status])
  @@index([workspaceId, provider, status])
  @@map("campaign_items")
}

/// External-action audit. Never store OAuth tokens, API keys, or raw secrets in metadata.
model ExternalActionAudit {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  workspaceId    String               @db.Uuid
  userId         String               @db.Uuid
  agentRunId     String?              @db.Uuid
  provider       IntegrationProvider?
  action         String
  target         String?
  status         ExternalActionStatus
  externalId     String?
  error          String?
  metadata       Json                 @default("{}")
  createdAt      DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, workspaceId, createdAt])
  @@index([workspaceId, action, createdAt])
  @@index([userId, createdAt])
  @@map("external_action_audits")
}

/// Phase 80 — Lieferschein → Rechnung. Monetary columns are Decimal (never float).
enum DeliveryNoteStatus {
  DRAFT
  OPEN
  ABGERECHNET
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  OVERDUE
  CANCELLED
}

enum FinanceDocumentKind {
  DELIVERY_NOTE
  INVOICE
}

enum FinanceIdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

model DeliveryNote {
  id                   String             @id @default(uuid()) @db.Uuid
  organizationId       String             @db.Uuid
  workspaceId          String             @db.Uuid
  customerId           String             @db.Uuid
  /// Snapshot of customer.companyName at create/update time (display, not tenancy).
  customerCompanyName  String
  number               String
  date                 DateTime           @db.Date
  orderNumber          String             @default("")
  status               DeliveryNoteStatus @default(OPEN)
  notes                String             @default("")
  currency             String             @default("EUR")
  netTotal             Decimal            @db.Decimal(19, 2)
  taxTotal             Decimal            @db.Decimal(19, 2)
  grossTotal           Decimal            @db.Decimal(19, 2)
  createdByUserId      String             @db.Uuid
  /// Frozen letterhead/template used while this note is OPEN; frozen after ABGERECHNET.
  documentSnapshot     Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy    User                 @relation("DeliveryNoteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items        DeliveryNoteItem[]
  invoiceLinks InvoiceDeliveryNote[]

  @@unique([workspaceId, number])
  @@index([organizationId])
  @@index([workspaceId, status])
  @@index([workspaceId, customerId])
  @@index([workspaceId, date])
  @@index([customerId])
  @@map("delivery_notes")
}

model DeliveryNoteItem {
  id              String   @id @default(uuid()) @db.Uuid
  deliveryNoteId  String   @db.Uuid
  organizationId  String   @db.Uuid
  workspaceId     String   @db.Uuid
  position        Int
  description     String
  quantity        Decimal  @db.Decimal(19, 4)
  unit            String   @default("Stk")
  unitPriceNet    Decimal  @db.Decimal(19, 4)
  taxRate         Decimal  @db.Decimal(5, 2)
  lineTotalNet    Decimal  @db.Decimal(19, 2)
  taxTotal        Decimal  @db.Decimal(19, 2)
  lineTotalGross  Decimal  @db.Decimal(19, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)

  @@index([deliveryNoteId])
  @@index([workspaceId])
  @@map("delivery_note_items")
}

model Invoice {
  id                   String        @id @default(uuid()) @db.Uuid
  organizationId       String        @db.Uuid
  workspaceId          String        @db.Uuid
  customerId           String        @db.Uuid
  customerCompanyName  String
  invoiceNumber        String
  invoiceDate          DateTime      @db.Date
  dueDate              DateTime      @db.Date
  status               InvoiceStatus @default(DRAFT)
  notes                String        @default("")
  currency             String        @default("EUR")
  netTotal             Decimal       @db.Decimal(19, 2)
  taxTotal             Decimal       @db.Decimal(19, 2)
  grossTotal           Decimal       @db.Decimal(19, 2)
  createdByUserId      String        @db.Uuid
  /// Frozen letterhead/template at billing time. Later branding edits do not rewrite this.
  documentSnapshot     Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer      Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy     User                  @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items         InvoiceItem[]
  deliveryNotes InvoiceDeliveryNote[]
  idempotencyKeys FinanceIdempotencyKey[]

  @@unique([workspaceId, invoiceNumber])
  @@index([organizationId])
  @@index([workspaceId, status])
  @@index([workspaceId, customerId])
  @@index([workspaceId, invoiceDate])
  @@index([workspaceId, dueDate])
  @@index([customerId])
  @@map("finance_invoices")
}

model InvoiceItem {
  id                String   @id @default(uuid()) @db.Uuid
  invoiceId         String   @db.Uuid
  organizationId    String   @db.Uuid
  workspaceId       String   @db.Uuid
  deliveryNoteId    String?  @db.Uuid
  deliveryNoteNumber String  @default("")
  position          Int
  description       String
  quantity          Decimal  @db.Decimal(19, 4)
  unit              String   @default("Stk")
  unitPriceNet      Decimal  @db.Decimal(19, 4)
  taxRate           Decimal  @db.Decimal(5, 2)
  lineTotalNet      Decimal  @db.Decimal(19, 2)
  taxTotal          Decimal  @db.Decimal(19, 2)
  lineTotalGross    Decimal  @db.Decimal(19, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([workspaceId])
  @@index([deliveryNoteId])
  @@map("finance_invoice_items")
}

/// Source Lieferschein references. deliveryNoteId is unique so a note cannot be billed twice.
model InvoiceDeliveryNote {
  id             String   @id @default(uuid()) @db.Uuid
  invoiceId      String   @db.Uuid
  deliveryNoteId String   @unique @db.Uuid
  organizationId String   @db.Uuid
  workspaceId    String   @db.Uuid
  createdAt      DateTime @default(now())

  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, deliveryNoteId])
  @@index([invoiceId])
  @@index([workspaceId])
  @@map("invoice_delivery_notes")
}

model FinanceNumberSequence {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  workspaceId    String              @db.Uuid
  kind           FinanceDocumentKind
  year           Int
  nextValue      Int                 @default(1)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, kind, year])
  @@index([organizationId])
  @@map("finance_number_sequences")
}

model FinanceIdempotencyKey {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @db.Uuid
  workspaceId    String                    @db.Uuid
  idempotencyKey String
  requestHash    String
  status         FinanceIdempotencyStatus  @default(IN_PROGRESS)
  invoiceId      String?                   @db.Uuid
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, idempotencyKey])
  @@index([organizationId])
  @@index([invoiceId])
  @@map("finance_idempotency_keys")
}

enum FinanceDocumentTemplate {
  CLASSIC
  MODERN
  COMPACT
  PROFESSIONAL
}

/// Immutable logo bytes. Replacing a logo creates a new row so issued documents keep the old file.
model FinanceDocumentLogo {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  workspaceId    String   @db.Uuid
  mimeType       String
  fileName       String   @default("")
  byteSize       Int
  bytes          Bytes
  uploadedByUserId String @db.Uuid
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation("FinanceDocumentLogoUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  settings     FinanceDocumentSettings[]

  @@index([organizationId])
  @@index([workspaceId])
  @@map("finance_document_logos")
}

/// Workspace letterhead and default templates. One row per workspace.
model FinanceDocumentSettings {
  id                   String                   @id @default(uuid()) @db.Uuid
  organizationId       String                   @db.Uuid
  workspaceId          String                   @unique @db.Uuid
  invoiceTemplate      FinanceDocumentTemplate  @default(CLASSIC)
  deliveryNoteTemplate FinanceDocumentTemplate  @default(CLASSIC)
  companyName          String                   @default("")
  street               String                   @default("")
  postalCode           String                   @default("")
  city                 String                   @default("")
  country              String                   @default("")
  phone                String                   @default("")
  email                String                   @default("")
  website              String                   @default("")
  vatId                String                   @default("")
  taxNumber            String                   @default("")
  iban                 String                   @default("")
  bic                  String                   @default("")
  commercialRegister   String                   @default("")
  managingDirector     String                   @default("")
  primaryColor           String                   @default("#1B365D")
  secondaryColor         String                   @default("#C4A35A")
  logoId                 String?                  @db.Uuid
  qrEnabled              Boolean                  @default(true)
  qrPosition             String                   @default("BOTTOM_RIGHT")
  qrIncludeAmount        Boolean                  @default(true)
  qrIncludeInvoiceNumber Boolean                  @default(true)
  qrIncludeCustomerName  Boolean                  @default(false)
  qrRemittanceText       String                   @default("")
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logo         FinanceDocumentLogo? @relation(fields: [logoId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([logoId])
  @@map("finance_document_settings")
}

/// Phase 18 — one protected Agent OS mutation per organization and idempotency key.
enum AgentGovernedExecutionStatus {
  RESERVED
  EXECUTING
  COMPLETED
  FAILED
  AMBIGUOUS
}

model AgentGovernedExecution {
  id                 String                        @id @default(uuid()) @db.Uuid
  organizationId     String                        @db.Uuid
  idempotencyKey     String
  executionId        String
  businessGoalId     String?
  planId             String?
  stepId             String?
  capabilityId       String
  workerId           String?
  actorId            String
  status             AgentGovernedExecutionStatus  @default(RESERVED)
  approvalRequired   Boolean                       @default(true)
  approvalGranted    Boolean                       @default(false)
  verificationStatus String                        @default("pending")
  /// Note id or queued delivery only. No message body, tokens, or credentials.
  outcome            Json                          @default("{}")
  /// When the current provider attempt started. Used only to detect an abandoned email attempt.
  attemptStartedAt   DateTime?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([executionId])
  @@index([businessGoalId])
  @@index([workerId])
  @@map("agent_governed_executions")
}

/// Append-only governed lifecycle evidence. Rows are not updated.
model AgentGovernedEvidence {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  executionId    String
  businessGoalId String?
  planId         String?
  stepId         String?
  capabilityId   String?
  workerId       String?
  actorId        String?
  action         String
  status         String
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([executionId])
  @@index([businessGoalId])
  @@map("agent_governed_evidence")
}

/// Phase 21 — AGXORA SaaS subscription. Separate from customer Finance invoices.
enum CommercialSubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum CommercialBillingInterval {
  month
  year
}

enum CommercialCheckoutStatus {
  OPEN
  COMPLETED
  EXPIRED
}

enum CommercialBillingEventStatus {
  PROCESSED
  IGNORED
  FAILED
}

/// One commercial subscription row per organization. No card data.
model CommercialSubscription {
  id                     String                         @id @default(uuid()) @db.Uuid
  organizationId         String                         @unique @db.Uuid
  planCode               String
  status                 CommercialSubscriptionStatus
  currency               String                         @default("EUR")
  interval               CommercialBillingInterval
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean                        @default(false)
  provider               String                         @default("stripe")
  providerCustomerId     String
  providerSubscriptionId String
  /// Stripe event.created of the last applied provider event. Older events are ignored.
  providerEventCreatedAt DateTime
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([provider, providerCustomerId])
  @@unique([provider, providerSubscriptionId])
  @@index([status])
  @@map("commercial_subscriptions")
}

/// In-flight Stripe Checkout session. Not proof of payment.
model CommercialCheckout {
  id                 String                   @id @default(uuid()) @db.Uuid
  organizationId     String                   @db.Uuid
  planCode           String
  interval           CommercialBillingInterval
  provider           String                   @default("stripe")
  providerSessionId  String                   @unique
  providerCustomerId String
  status             CommercialCheckoutStatus @default(OPEN)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([providerCustomerId])
  @@map("commercial_checkouts")
}

/// Idempotent provider event log. Payload is a safe reference, never a secret or raw card.
model CommercialBillingEvent {
  id              String                       @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String
  organizationId  String?                      @db.Uuid
  eventType       String
  eventCreatedAt  DateTime
  processedAt     DateTime?
  status          CommercialBillingEventStatus
  safePayload     Json                         @default("{}")
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([organizationId, createdAt])
  @@index([eventType])
  @@map("commercial_billing_events")
}
