// AGXORA Phase 42.1 + Phase 43 + Phase 44 + Phase 45-B + Phase 47
// PostgreSQL source of truth for User / Organization / Workspace / Membership /
// Session / Customer / Contact / Invitation / OwnershipTransfer / ControlPlaneAuditEvent

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REVOKED
}

enum CustomerStatus {
  lead
  prospect
  active
  inactive
  vip
  archived
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique
  name           String
  /// Legacy LocalAuth id (usr_…) — not used as authentication authority
  externalAuthId String?  @unique
  emailVerified  Boolean  @default(false)
  /// bcrypt password hash (Phase 43). Never return to clients.
  passwordHash   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships            Membership[]
  sessions               Session[]
  ownedOrganizations      Organization[]          @relation("OrganizationOwner")
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  invitationsSent         Invitation[]            @relation("InvitationInviter")
  ownershipTransfersFrom  OwnershipTransfer[]     @relation("OwnershipTransferFrom")
  ownershipTransfersTo    OwnershipTransfer[]     @relation("OwnershipTransferTo")
  auditEvents             ControlPlaneAuditEvent[]

  @@index([externalAuthId])
  @@map("users")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  ownerId   String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User         @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  workspaces  Workspace[]
  memberships Membership[]
  customers   Customer[]
  contacts    Contact[]
  invitations         Invitation[]
  ownershipTransfers  OwnershipTransfer[]
  auditEvents         ControlPlaneAuditEvent[]

  @@index([ownerId])
  @@map("organizations")
}

model Workspace {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  slug           String
  /// Soft archive — archived workspaces cannot be switched into or mutated
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  customers    Customer[]
  contacts     Contact[]
  invitations         Invitation[]
  ownershipTransfers  OwnershipTransfer[]
  auditEvents         ControlPlaneAuditEvent[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([archivedAt])
  @@map("workspaces")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  workspaceId    String           @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([organizationId])
  @@index([workspaceId])
  @@index([userId, organizationId, status])
  @@map("memberships")
}

/// Workspace invitation — raw token is never stored; only tokenHash.
model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  workspaceId    String    @db.Uuid
  invitedEmail   String
  role           MembershipRole
  tokenHash      String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  invitedById    String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([workspaceId, invitedEmail])
  @@index([organizationId])
  @@index([expiresAt])
  @@index([invitedById])
  @@map("invitations")
}

/// Controlled org ownership transfer — raw confirmation token never stored.
/// Pending transfer does not change Organization.ownerId or membership roles.
model OwnershipTransfer {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  workspaceId    String    @db.Uuid
  fromUserId     String    @db.Uuid
  toUserId       String    @db.Uuid
  tokenHash      String    @unique
  expiresAt      DateTime
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromUser     User         @relation("OwnershipTransferFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser       User         @relation("OwnershipTransferTo", fields: [toUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, expiresAt])
  @@index([workspaceId])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("ownership_transfers")
}

/// Compact control-plane audit — no secrets, no raw tokens.
model ControlPlaneAuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  workspaceId    String?  @db.Uuid
  actorUserId    String   @db.Uuid
  action         String
  targetUserId   String?  @db.Uuid
  invitationId   String?  @db.Uuid
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor        User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("control_plane_audit_events")
}

/// Server-authoritative session. Token is high-entropy; cookie is httpOnly.
model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  token             String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  /// Active workspace for multi-membership users — must be a membership of this user
  activeWorkspaceId String?   @db.Uuid
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

/// One-time password reset tokens — only tokenHash is stored.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Email verification tokens — delivery is a Phase follow-up when mail is configured.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  workspaceId    String         @db.Uuid
  companyName    String
  contactName    String
  email          String
  phone          String         @default("")
  website        String         @default("")
  industry       String         @default("")
  country        String         @default("")
  city           String         @default("")
  address        String         @default("")
  taxNumber      String         @default("")
  status         CustomerStatus @default(lead)
  owner          String         @default("")
  /// CrmTag[] JSON — label + color
  tags           Json           @default("[]")
  /// Marks seed/sample rows for honesty (Phase 40)
  isSample       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts     Contact[]

  @@index([workspaceId])
  @@index([organizationId])
  @@index([workspaceId, email])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@map("customers")
}

/// Phase 47 — CRM contact person (profile), not the deferred Note entity.
model Contact {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  workspaceId    String   @db.Uuid
  customerId     String   @db.Uuid
  name           String
  role           String   @default("")
  email          String   @default("")
  phone          String   @default("")
  mobile         String   @default("")
  /// Free-text notes on the contact person (not CrmNoteRecord persistence).
  notes          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([workspaceId])
  @@index([organizationId])
  @@index([customerId, createdAt])
  @@index([workspaceId, customerId])
  @@map("contacts")
}
