# AGXORA environment template — never commit real secrets.

# --- Runtime ---
NEXT_PUBLIC_AGXORA_ENV=development
NEXT_PUBLIC_AGXORA_SITE_URL=https://agxora.app
NEXT_PUBLIC_AGXORA_VERSION=0.39.0

# --- Public company identity (legal / contact) ---
NEXT_PUBLIC_AGXORA_COMPANY_NAME=AGXORA
NEXT_PUBLIC_AGXORA_LEGAL_NAME=AGXORA
NEXT_PUBLIC_AGXORA_EMAIL_COMPANY=hello@agxora.app
NEXT_PUBLIC_AGXORA_EMAIL_SUPPORT=support@agxora.app
NEXT_PUBLIC_AGXORA_EMAIL_SALES=sales@agxora.app
NEXT_PUBLIC_AGXORA_EMAIL_PRIVACY=privacy@agxora.app
NEXT_PUBLIC_AGXORA_ADDRESS_LINE1=
NEXT_PUBLIC_AGXORA_ADDRESS_LINE2=
NEXT_PUBLIC_AGXORA_ADDRESS_COUNTRY=
NEXT_PUBLIC_AGXORA_MANAGING_DIRECTOR=
NEXT_PUBLIC_AGXORA_REGISTER_COURT=
NEXT_PUBLIC_AGXORA_REGISTER_NUMBER=
NEXT_PUBLIC_AGXORA_VAT_ID=
NEXT_PUBLIC_AGXORA_LEGAL_UPDATED=August 6, 2026

NODE_ENV=development

# --- Auth / security ---
# Soft auth gate for protected routes (set true in production)
AGXORA_AUTH_REQUIRED=false

# --- Data platform ---
NEXT_PUBLIC_AGXORA_API_BASE_URL=/api
NEXT_PUBLIC_AGXORA_DATA_PROVIDER=local
AGXORA_USE_MOCKS=true
AGXORA_REQUEST_TIMEOUT_MS=15000
AGXORA_RETRY_ATTEMPTS=2
AGXORA_RETRY_BACKOFF_MS=400

# --- AI providers (optional) ---
AGXORA_OPENAI_API_KEY=
AGXORA_ANTHROPIC_API_KEY=
AGXORA_GOOGLE_API_KEY=
AGXORA_OPENROUTER_API_KEY=
AGXORA_OLLAMA_BASE_URL=http://127.0.0.1:11434
AGXORA_AZURE_OPENAI_API_KEY=
AGXORA_LOCAL_LLM_BASE_URL=

# --- Observability (future) ---
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
