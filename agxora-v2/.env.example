# AGXORA environment template — never commit real secrets.

# --- Runtime ---
NEXT_PUBLIC_AGXORA_ENV=development
NEXT_PUBLIC_AGXORA_SITE_URL=https://agxora.app
NEXT_PUBLIC_AGXORA_VERSION=0.39.0

# --- Public company identity (legal / contact) ---
NEXT_PUBLIC_AGXORA_COMPANY_NAME=AGXORA
NEXT_PUBLIC_AGXORA_LEGAL_NAME=AGXORA
NEXT_PUBLIC_AGXORA_EMAIL_COMPANY=hello@agxora.app
NEXT_PUBLIC_AGXORA_EMAIL_SUPPORT=support@agxora.app
NEXT_PUBLIC_AGXORA_EMAIL_SALES=sales@agxora.app
NEXT_PUBLIC_AGXORA_EMAIL_PRIVACY=privacy@agxora.app
NEXT_PUBLIC_AGXORA_ADDRESS_LINE1=
NEXT_PUBLIC_AGXORA_ADDRESS_LINE2=
NEXT_PUBLIC_AGXORA_ADDRESS_COUNTRY=
NEXT_PUBLIC_AGXORA_MANAGING_DIRECTOR=
NEXT_PUBLIC_AGXORA_REGISTER_COURT=
NEXT_PUBLIC_AGXORA_REGISTER_NUMBER=
NEXT_PUBLIC_AGXORA_VAT_ID=
NEXT_PUBLIC_AGXORA_LEGAL_UPDATED=August 6, 2026

NODE_ENV=development

# --- Auth / security ---
# Soft auth gate for protected routes (set true in production)
AGXORA_AUTH_REQUIRED=false
# Auth mode: server (Phase 43 production path) | local (offline LocalAuth demo only)
NEXT_PUBLIC_AGXORA_AUTH_MODE=server
# Expose reset tokens in API responses for local/dev tests only — never in production
# AGXORA_AUTH_EXPOSE_RESET_TOKEN=1
# Legacy flag (Phase 43). Alone it does NOT enable delivery — use AGXORA_EMAIL_PROVIDER.
# AGXORA_AUTH_EMAIL_DELIVERY=not_configured

# --- Rate limiting (Phase 46-A / 46-B) — server-only ---
# Master switch (default true). Set false only for local debugging.
AGXORA_RATE_LIMIT_ENABLED=true
# Trust X-Forwarded-For / X-Real-IP from the reverse proxy (required in production).
AGXORA_TRUST_PROXY=false
# Store backend: memory (default) | http (shared worker — Phase 46-B)
# AGXORA_RATE_LIMIT_STORE=memory
# Max distinct in-memory keys (memory store only; fail-closed when exceeded)
# AGXORA_RATE_LIMIT_MAX_KEYS=10000
# Optional per-policy overrides, e.g.:
# AGXORA_RATE_LIMIT_AUTH_LOGIN_MAX=20
# AGXORA_RATE_LIMIT_AUTH_LOGIN_WINDOW_MS=900000
# HTTP shared store (no extra npm deps) — POST JSON { key, max, windowMs, now }
# AGXORA_RATE_LIMIT_HTTP_URL=https://rate-limit-worker.example/consume
# AGXORA_RATE_LIMIT_HTTP_TOKEN=
# AGXORA_RATE_LIMIT_HTTP_TIMEOUT_MS=2500

# --- Email delivery (Phase 45) — server-only ---
# Provider: none (default) | console | http | memory (tests only)
AGXORA_EMAIL_PROVIDER=none
# From address used by providers that submit outbound mail
AGXORA_EMAIL_FROM=noreply@agxora.app
# Optional absolute app origin override for email links (defaults to NEXT_PUBLIC_AGXORA_SITE_URL)
# AGXORA_APP_ORIGIN=http://localhost:3000
# HTTP webhook provider (no extra npm deps) — POST JSON { from, to, subject, text, kind, actionUrl }
# AGXORA_EMAIL_HTTP_URL=https://mail-worker.example/v1/send
# AGXORA_EMAIL_HTTP_TOKEN=

# --- Database (Phase 42.1) ---
# Server-only PostgreSQL connection. NEVER expose to the browser.
DATABASE_URL=postgresql://agxora:agxora_dev@127.0.0.1:5432/agxora_dev
# Optional dedicated test database (used by vitest via .env.test)
# DATABASE_URL=postgresql://agxora:agxora_dev@127.0.0.1:5432/agxora_test

# CRM persistence mode:
# - local    = existing LocalStorage CRM (default, offline-friendly)
# - database = PostgreSQL via /api/v1/crm/customers (+ Phase 47 contacts, Phase 48 notes,
#              Phase 49 document metadata, Phase 50 activities)
# Phase 57 production gate requires database with Agent OS=server + auth=server.
NEXT_PUBLIC_AGXORA_CRM_PERSISTENCE=local

# Agent OS persistence (Phase 56)
# local  = browser localStorage (demo/dev default)
# server = org-scoped Postgres via /api/v1/agents/os-state (first-customer path)
# Phase 57 production gate requires server with CRM=database + auth=server + email != none.
NEXT_PUBLIC_AGXORA_AGENT_OS_PERSISTENCE=local

# --- Data platform ---
NEXT_PUBLIC_AGXORA_API_BASE_URL=/api
NEXT_PUBLIC_AGXORA_DATA_PROVIDER=local
AGXORA_USE_MOCKS=true
AGXORA_REQUEST_TIMEOUT_MS=15000
AGXORA_RETRY_ATTEMPTS=2
AGXORA_RETRY_BACKOFF_MS=400

# --- AI providers (optional) ---
AGXORA_OPENAI_API_KEY=
AGXORA_ANTHROPIC_API_KEY=
AGXORA_GOOGLE_API_KEY=
AGXORA_OPENROUTER_API_KEY=
AGXORA_OLLAMA_BASE_URL=http://127.0.0.1:11434
AGXORA_AZURE_OPENAI_API_KEY=
AGXORA_LOCAL_LLM_BASE_URL=

# --- Observability (future) ---
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
